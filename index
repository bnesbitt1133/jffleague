<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jungle Fantasy Football League — History &amp; Hall of Fame</title>
<style>
  :root{
    --void:#0a0908;
    --panel:#141210;
    --panel-2:#1c1916;
    --line:#332c22;
    --orange:#f2701c;
    --amber:#ff9927;
    --amber-glow: rgba(255,153,39,0.55);
    --white:#f5f3ef;
    --gray:#9a9388;
    --gray-dim:#645c50;
    --shadow: 0 20px 50px rgba(0,0,0,0.55);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;overflow-x:hidden;max-width:100%;}
  body{
    background:
      radial-gradient(ellipse 900px 500px at 15% -10%, rgba(242,112,28,0.10), transparent 60%),
      radial-gradient(ellipse 700px 500px at 100% 0%, rgba(255,153,39,0.07), transparent 55%),
      var(--void);
    color:var(--white);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:1080px;margin:0 auto;padding:28px 22px 90px;width:100%;overflow-x:hidden;}

  /* ---------- Header ---------- */
  header{
    display:flex;
    align-items:center;
    gap:22px;
    padding-bottom:22px;
    margin-bottom:8px;
    border-bottom:1px solid var(--line);
  }
  header img{
    width:74px;height:74px;border-radius:50%;
    box-shadow:0 0 0 2px var(--line), 0 8px 24px rgba(0,0,0,0.6);
    flex-shrink:0;
  }
  .title-block h1{
    margin:0;
    font-size:26px;
    font-weight:900;
    letter-spacing:0.5px;
    text-transform:uppercase;
    color:var(--white);
    line-height:1.1;
  }
  .title-block h1 span{color:var(--orange);}
  .title-block .sub{
    margin-top:6px;
    font-size:13px;
    color:var(--gray);
    letter-spacing:0.4px;
  }
  .title-block .sub b{color:var(--amber);font-weight:700;}

  /* ---------- Nav tabs ---------- */
  nav.maintabs{
    display:flex;
    gap:6px;
    margin:26px 0 30px;
    border-bottom:1px solid var(--line);
  }
  nav.maintabs button{
    appearance:none;border:none;background:none;
    color:var(--gray);
    font-size:14px;
    font-weight:800;
    letter-spacing:0.6px;
    text-transform:uppercase;
    padding:12px 4px;
    margin-right:26px;
    cursor:pointer;
    position:relative;
    transition:color .2s ease;
  }
  nav.maintabs button:hover{color:var(--white);}
  nav.maintabs button.active{color:var(--white);}
  nav.maintabs button.active::after{
    content:"";
    position:absolute;left:0;right:0;bottom:-1px;height:3px;
    background:linear-gradient(90deg,var(--orange),var(--amber));
    box-shadow:0 0 10px var(--amber-glow);
    border-radius:3px 3px 0 0;
  }

  .panel{
    display:none;
  }
  .panel.active{display:block; animation: fadein .35s ease;}
  @keyframes fadein{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);} }

  .eyebrow{
    font-size:12px;
    font-weight:800;
    letter-spacing:1.6px;
    text-transform:uppercase;
    color:var(--amber);
    margin:0 0 6px;
  }
  h2.sectiontitle{
    font-size:22px;
    margin:0 0 4px;
    font-weight:900;
    letter-spacing:0.3px;
  }
  p.desc{
    color:var(--gray);
    font-size:14px;
    line-height:1.5;
    margin:0 0 22px;
    max-width:640px;
  }

  /* ---------- Pill selector (years / records) ---------- */
  .pillrow{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:22px;
  }
  .pill{
    appearance:none;
    border:1px solid var(--line);
    background:var(--panel);
    color:var(--gray);
    font-size:13px;
    font-weight:700;
    padding:9px 16px;
    border-radius:100px;
    cursor:pointer;
    transition:all .18s ease;
    letter-spacing:0.2px;
  }
  .pill:hover{
    border-color:var(--amber);
    color:var(--white);
  }
  .pill.active{
    background:linear-gradient(135deg,var(--orange),var(--amber));
    border-color:transparent;
    color:#1a0f04;
    box-shadow:0 4px 18px var(--amber-glow);
  }

  /* ---------- Card ---------- */
  .card{
    background:linear-gradient(180deg,var(--panel) 0%, var(--panel-2) 100%);
    border:1px solid var(--line);
    border-radius:14px;
    padding:26px 24px 20px;
    box-shadow:var(--shadow);
    margin-bottom:22px;
  }
  .card-head{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:18px;
  }
  .card-head h3{
    margin:0;
    font-size:17px;
    font-weight:800;
    letter-spacing:0.2px;
    overflow-wrap:break-word;
    min-width:0;
  }
  .card-head h3 .champname{color:var(--amber);}
  .card-head .meta{
    font-size:12px;
    color:var(--gray-dim);
    font-weight:600;
    letter-spacing:0.3px;
    text-transform:uppercase;
  }

  /* ---------- Champions list ---------- */
  .champlist{display:flex;flex-direction:column;}
  .champrow-item{
    display:grid;
    grid-template-columns:56px minmax(0,1fr) auto;
    grid-template-areas: "year info record";
    align-items:center;
    gap:16px;
    padding:16px 4px;
    border-bottom:1px solid rgba(51,44,34,0.6);
    transition:background .15s ease;
  }
  .champlist .champrow-item:last-child{border-bottom:none;}
  .champrow-item:hover{background:rgba(255,153,39,0.05);}
  .champrow-item .cinfo{min-width:0;grid-area:info;}
  .champrow-item .cyear{
    grid-area:year;
    font-size:20px;
    font-weight:900;
    color:var(--gray);
    letter-spacing:0.2px;
  }
  .champrow-item:first-child .cyear{color:var(--amber);}
  .champrow-item .cname{
    font-size:16.5px;
    font-weight:800;
    color:var(--white);
    overflow-wrap:break-word;
  }
  .champrow-item .cowner{
    font-size:12.5px;
    color:var(--gray);
    margin-top:2px;
    font-weight:600;
    overflow-wrap:break-word;
  }
  .champrow-item .crecord{
    grid-area:record;
    font-size:15px;
    font-weight:800;
    color:var(--amber);
    background:rgba(255,153,39,0.10);
    border:1px solid rgba(255,153,39,0.3);
    padding:6px 14px;
    border-radius:100px;
    white-space:nowrap;
  }
  .trophy-badge{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:20px;height:20px;
    margin-right:6px;
    vertical-align:-4px;
  }

  /* ---------- Bar rows (horizontal chart) ---------- */
  .barchart{display:flex;flex-direction:column;gap:13px;}
  .barrow{
    display:flex;
    flex-direction:column;
    gap:5px;
  }
  .barrow .rlabel{
    font-size:12.5px;
    font-weight:700;
    color:var(--gray);
    overflow-wrap:break-word;
  }
  .barrow .rlabel .rowner{color:var(--gray-dim);font-weight:600;}
  .barrow.champ .rlabel{color:var(--amber);}
  .barrow.champ .rlabel .rowner{color:var(--amber);opacity:0.75;}
  .barrow .trackrow{
    display:flex;
    align-items:center;
    gap:10px;
  }
  .barrow .track{
    flex:1;
    background:#000;
    border-radius:6px;
    height:20px;
    overflow:hidden;
    position:relative;
    border:1px solid var(--line);
  }
  .barrow .fill{
    height:100%;
    width:0%;
    border-radius:5px;
    background:linear-gradient(90deg,var(--orange),var(--amber));
    transition:width .7s cubic-bezier(.2,.8,.2,1);
  }
  .barrow.champ .fill{
    background:linear-gradient(90deg,var(--amber),#ffc670);
    box-shadow:0 0 14px var(--amber-glow);
  }
  .barrow .val{
    font-size:12.5px;
    font-weight:800;
    color:var(--white);
    text-align:right;
    width:64px;
    flex-shrink:0;
  }
  .barrow.champ .val{color:var(--amber);}

  /* vertical mini bars (for records) */
  .vbars{
    display:flex;
    align-items:flex-end;
    gap:10px;
    height:220px;
    padding:0 4px;
    border-bottom:1px solid var(--line);
    margin-bottom:10px;
    overflow-x:auto;
  }
  .vbar-col{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:flex-end;
    flex:1;
    min-width:74px;
    height:100%;
    cursor:pointer;
  }
  .vbar-col .vval{
    font-size:12px;
    font-weight:800;
    color:var(--white);
    margin-bottom:6px;
    white-space:nowrap;
  }
  .vbar-col .vbar{
    width:34px;
    border-radius:5px 5px 3px 3px;
    background:linear-gradient(180deg,var(--amber),var(--orange));
    transition:height .7s cubic-bezier(.2,.8,.2,1);
    box-shadow:0 0 0 1px rgba(0,0,0,0.4) inset;
  }
  .vbar-col:hover .vbar{filter:brightness(1.15);}
  .vbar-col .vyear{
    margin-top:8px;
    font-size:12px;
    font-weight:800;
    color:var(--gray);
  }
  .vbar-col .vsub{
    font-size:10.5px;
    color:var(--gray-dim);
    text-align:center;
    line-height:1.3;
    margin-top:2px;
    max-width:80px;
    overflow-wrap:break-word;
  }
  .vbar-col.selected .vyear{color:var(--amber);}
  .vbar-col.selected .vbar{background:linear-gradient(180deg,#ffc670,var(--amber));box-shadow:0 0 14px var(--amber-glow);}

  .detailbox{
    background:var(--void);
    border:1px solid var(--line);
    border-radius:10px;
    padding:16px 18px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:12px;
  }
  .detailbox .dinfo{min-width:0;flex:1 1 200px;}
  .detailbox .dname{font-size:17px;font-weight:900;color:var(--amber);overflow-wrap:break-word;}
  .detailbox .dsub{font-size:12.5px;color:var(--gray);margin-top:3px;overflow-wrap:break-word;}
  .detailbox .dpts{font-size:28px;font-weight:900;color:var(--white);}
  .detailbox .dpts span{font-size:12px;color:var(--gray-dim);font-weight:700;display:block;text-transform:uppercase;letter-spacing:0.5px;}

  /* ---------- Table ---------- */
  .table-card{padding-left:0;padding-right:0;}
  .table-scroll{
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
    padding:0 24px;
  }
  table{
    width:100%;
    border-collapse:collapse;
    font-size:13px;
    table-layout:fixed;
  }
  th:nth-child(1), td:nth-child(1){width:9%;}
  th:nth-child(2), td:nth-child(2){width:26%;}
  th:nth-child(3), td:nth-child(3){width:23%;}
  th:nth-child(4), td:nth-child(4){width:13%;}
  th:nth-child(5), td:nth-child(5){width:14.5%;}
  th:nth-child(6), td:nth-child(6){width:14.5%;}
  thead th{
    text-align:left;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:0.5px;
    color:var(--gray-dim);
    font-weight:800;
    padding:8px 10px;
    border-bottom:1px solid var(--line);
    white-space:nowrap;
  }
  thead th.num, tbody td.num{text-align:right;white-space:nowrap;overflow:hidden;}
  thead th{overflow:hidden;}
  tbody td{
    padding:9px 10px;
    border-bottom:1px solid rgba(51,44,34,0.5);
    color:var(--white);
    overflow-wrap:break-word;
  }
  tbody tr:last-child td{border-bottom:none;}
  tbody tr.champrow td{color:var(--amber); font-weight:800; background:rgba(255,153,39,0.07);}
  tbody tr:hover td{background:rgba(255,153,39,0.05);}

  footer{
    text-align:center;
    color:var(--gray-dim);
    font-size:11.5px;
    margin-top:40px;
    letter-spacing:0.3px;
  }

  @media(max-width:600px){
    .barrow .rlabel{font-size:11px;}
    header{gap:14px;}
    header img{width:56px;height:56px;}
    .title-block h1{font-size:19px;}
    nav.maintabs button{margin-right:16px;font-size:12.5px;}
    .table-scroll{padding:0 10px;}
    table{font-size:10.3px;}
    thead th{font-size:8.3px;padding:6px 3px;letter-spacing:0.1px;}
    tbody td{padding:7px 3px;}
    th:nth-child(1), td:nth-child(1){width:9%;}
    th:nth-child(2), td:nth-child(2){width:26%;}
    th:nth-child(3), td:nth-child(3){width:22%;}
    th:nth-child(4), td:nth-child(4){width:12%;}
    th:nth-child(5), td:nth-child(5){width:15.5%;}
    th:nth-child(6), td:nth-child(6){width:15.5%;}
    .card{padding:20px 16px 16px;}
    .champrow-item{
      grid-template-columns:1fr auto;
      grid-template-areas:
        "year record"
        "info info";
      row-gap:6px;
      column-gap:10px;
      padding:14px 4px;
    }
    .champrow-item .cyear{font-size:16px;}
    .champrow-item .cname{font-size:14.5px;}
    .champrow-item .crecord{font-size:13px;padding:5px 10px;}
  }
</style>
</head>
