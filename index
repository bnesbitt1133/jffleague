    <div class="title-block">
      <h1>Jungle <span>Fantasy Football</span> League</h1>
      <div class="sub">Est. 2018 &nbsp;&bull;&nbsp; <b>8 Seasons</b> &nbsp;&bull;&nbsp; League History &amp; Hall of Fame</div>
    </div>
  </header>

  <nav class="maintabs" id="maintabs">
    <button data-tab="champions" class="active">Champions</button>
    <button data-tab="records">League Records</button>
    <button data-tab="standings">Season Standings</button>
  </nav>

  <!-- ================= CHAMPIONS TAB ================= -->
  <section class="panel active" id="panel-champions">
    <div class="eyebrow">Fantasy Super Bowl</div>
    <h2 class="sectiontitle">Champions</h2>
    <p class="desc">Every ring holder in league history.</p>

    <div class="card" style="padding:8px 24px;">
      <div class="champlist" id="champ-list"></div>
    </div>
  </section>

  <!-- ================= RECORDS TAB ================= -->
  <section class="panel" id="panel-records">
    <div class="eyebrow">Hall of Fame</div>
    <h2 class="sectiontitle">League Records</h2>
    <p class="desc">The single-week and single-season high-water marks since 2018.</p>

    <div class="pillrow" id="record-pills">
      <button class="pill active" data-rec="team_points_week">Most Team Points &mdash; Week</button>
      <button class="pill" data-rec="team_points_season">Most Team Points &mdash; Season</button>
      <button class="pill" data-rec="player_points">Most Player Points &mdash; Week</button>
    </div>

    <div class="card">
      <div class="vbars" id="record-bars"></div>
      <div class="detailbox" id="record-detail"></div>
    </div>
  </section>

  <!-- ================= STANDINGS TAB ================= -->
  <section class="panel" id="panel-standings">
    <div class="eyebrow">Final Regular-Season Standings</div>
    <h2 class="sectiontitle">Pick a Season</h2>
    <p class="desc">Full 12-team standings for every year of the league. Champion highlighted in amber.</p>

    <div class="pillrow" id="year-pills"></div>

    <div class="card">
      <div class="card-head">
        <h3>Points For &mdash; <span class="champname" id="standings-champ"></span></h3>
        <div class="meta" id="standings-year"></div>
      </div>
      <div class="barchart" id="standings-bars"></div>
    </div>

    <div class="card table-card">
      <div class="table-scroll">
        <table id="standings-table">
          <thead>
            <tr>
              <th>Rank</th><th>Team</th><th>Owner</th>
              <th class="num">W&ndash;L</th><th class="num">Pts For</th><th class="num">Pts Agst</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </section>

  <footer>Jungle Fantasy Football League &mdash; League History Dashboard</footer>
</div>

