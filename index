function buildChampions(){
  const wrap = document.getElementById('champ-list');
  const champs = DATA.champions; // already most-recent-first
  wrap.innerHTML='';
  champs.forEach((c)=>{
    const row = document.createElement('div');
    row.className='champrow-item';
    row.innerHTML = `
      <div class="cyear">${c.year}</div>
      <div class="cinfo">
        <div class="cname">${c.team}</div>
        <div class="cowner">Owner: ${c.owner}</div>
      </div>
      <div class="crecord">${c.record}</div>
    `;
    wrap.appendChild(row);
  });
}

/* ================= RECORDS ================= */
const RECORD_CONFIG = {
  team_points_week: {
    unit:'pts',
    val:d=>d.points,
    sub:d=>`Owner: ${d.owner} &middot; Wk ${d.week}`,
    name:d=>d.team,
    detailTitle:d=>d.team,
    detailSub:d=>`Owner: ${d.owner} &middot; ${d.year} &middot; Week ${d.week}`,
    detailVal:d=>d.points.toFixed(2),
    detailLabel:'Points'
  },
  team_points_season: {
    unit:'pts',
    val:d=>d.points,
    sub:d=>`Owner: ${d.owner}`,
    name:d=>d.team,
    detailTitle:d=>d.team,
    detailSub:d=>`Owner: ${d.owner} &middot; ${d.year} Season Total`,
    detailVal:d=>d.points.toFixed(2),
    detailLabel:'Points'
  },
  player_points: {
    unit:'pts',
    val:d=>d.points,
    sub:d=>`Wk ${d.week}`,
    name:d=>`${d.player} &middot; ${d.team} (${d.owner})`,
    detailTitle:d=>`${d.player} <span style="color:var(--gray);font-weight:700;font-size:13px;">(${d.pos})</span>`,
    detailSub:d=>`${d.team} &mdash; Owner: ${d.owner} &middot; ${d.year} &middot; Week ${d.week}`,
    detailVal:d=>d.points.toFixed(2),
    detailLabel:'Points'
  }
};
let currentRecord = 'team_points_week';

function buildRecords(){
  const wrap = document.getElementById('record-bars');
  const cfg = RECORD_CONFIG[currentRecord];
  const rows = DATA[currentRecord].slice().reverse();
  const maxVal = Math.max(...rows.map(cfg.val));
  wrap.innerHTML='';
  rows.forEach((d, idx)=>{
    const col = document.createElement('div');
    col.className='vbar-col';
    col.dataset.idx = idx;
    col.innerHTML = `
      <div class="vval">${cfg.val(d).toFixed(2)}</div>
      <div class="vbar" style="height:0px"></div>
      <div class="vyear">${d.year}</div>
      <div class="vsub">${cfg.name(d)}<br>${cfg.sub(d)}</div>
    `;
    col.addEventListener('click', ()=>selectRecord(idx));
    wrap.appendChild(col);
  });
  requestAnimationFrame(()=>{
    document.querySelectorAll('#record-bars .vbar-col').forEach((col,idx)=>{
      const v = cfg.val(rows[idx]);
      col.querySelector('.vbar').style.height = (18 + (v/maxVal)*160)+'px';
    });
  });
  selectRecord(rows.length-1);
}
function selectRecord(idx){
  const cfg = RECORD_CONFIG[currentRecord];
  const rows = DATA[currentRecord].slice().reverse();
  document.querySelectorAll('#record-bars .vbar-col').forEach(c=>c.classList.remove('selected'));
  const col = document.querySelector(`#record-bars .vbar-col[data-idx="${idx}"]`);
  if(col) col.classList.add('selected');
  const d = rows[idx];
  document.getElementById('record-detail').innerHTML = `
    <div class="dinfo">
      <div class="dname">${cfg.detailTitle(d)}</div>
      <div class="dsub">${cfg.detailSub(d)}</div>
    </div>
    <div class="dpts">${cfg.detailVal(d)}<span>${cfg.detailLabel}</span></div>
  `;
}
document.querySelectorAll('#record-pills .pill').forEach(p=>{
  p.addEventListener('click', ()=>{
    document.querySelectorAll('#record-pills .pill').forEach(x=>x.classList.remove('active'));
    p.classList.add('active');
    currentRecord = p.dataset.rec;
    buildRecords();
  });
});

/* ================= STANDINGS ================= */
function matchChamp(teamName, champ){
  const tn = teamName.replace(/\.+$/,'').trim();
  return tn === champ || champ.startsWith(tn);
}
function buildYearPills(){
  const wrap = document.getElementById('year-pills');
  wrap.innerHTML='';
  DATA.standings_years.forEach((yr,i)=>{
    const b = document.createElement('button');
    b.className = 'pill'+(i===0?' active':'');
    b.textContent = yr;
    b.dataset.year = yr;
    b.addEventListener('click', ()=>{
      document.querySelectorAll('#year-pills .pill').forEach(x=>x.classList.remove('active'));
      b.classList.add('active');
      buildStandings(yr);
    });
    wrap.appendChild(b);
  });
}
function buildStandings(year){
  const info = DATA.standings[year];
  document.getElementById('standings-champ').textContent = info.champion;
  document.getElementById('standings-year').textContent = year+' Season';

  const teams = info.teams.slice().sort((a,b)=>a.rank-b.rank);
  const maxPts = Math.max(...teams.map(t=>t.pts_for));

  const barsWrap = document.getElementById('standings-bars');
  barsWrap.innerHTML='';
  teams.forEach(t=>{
    const isChamp = matchChamp(t.team, info.champion);
    const row = document.createElement('div');
    row.className = 'barrow'+(isChamp?' champ':'');
    row.innerHTML = `
      <div class="rlabel">#${t.rank} ${t.team} <span class="rowner">&mdash; ${t.owner}</span></div>
      <div class="trackrow">
        <div class="track"><div class="fill" style="width:0%"></div></div>
        <div class="val">${t.pts_for.toFixed(2)}</div>
      </div>
    `;
    barsWrap.appendChild(row);
  });
  requestAnimationFrame(()=>{
    barsWrap.querySelectorAll('.barrow').forEach((row,idx)=>{
      const pct = (teams[idx].pts_for/maxPts)*100;
      row.querySelector('.fill').style.width = pct+'%';
    });
  });

  const tbody = document.querySelector('#standings-table tbody');
  tbody.innerHTML='';
  teams.forEach(t=>{
    const isChamp = matchChamp(t.team, info.champion);
    const tr = document.createElement('tr');
    if(isChamp) tr.className='champrow';
    tr.innerHTML = `
      <td>${t.rank}</td>
      <td>${t.team}</td>
      <td>${t.owner}</td>
      <td class="num">${t.wl}</td>
      <td class="num">${t.pts_for.toFixed(2)}</td>
      <td class="num">${t.pts_agst.toFixed(2)}</td>
    `;
    tbody.appendChild(tr);
  });
}

/* ---------------- init ---------------- */
buildChampions();
buildRecords();
buildYearPills();
buildStandings(DATA.standings_years[0]);
</script>
</body>
</html>
